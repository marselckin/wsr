import os
import sys


def analyze_png_chunks(png_file):
    """
    Полный анализ всех чанков PNG файла
    """
    if not os.path.exists(png_file):
        print(f"❌ Файл {png_file} не найден!")
        return [], []

    with open(png_file, 'rb') as f:
        # Проверяем сигнатуру PNG
        signature = f.read(8)
        if signature != b'\x89PNG\r\n\x1a\n':
            print("❌ Не PNG файл!")
            return [], []

        print(f"✅ PNG файл: {png_file}")
        print("=" * 70)

        chunk_count = 0
        messages = []
        chunks_info = []

        while True:
            # Читаем длину чанка
            length_data = f.read(4)
            if len(length_data) < 4:
                break
            length = struct.unpack('>I', length_data)[0]

            # Читаем тип чанка
            chunk_type = f.read(4).decode('ascii')
            chunk_count += 1

            # Читаем данные чанка
            data = f.read(length)

            # Читаем CRC
            crc = f.read(4)

            print(f"\n📦 Чанк #{chunk_count}: {chunk_type} (длина: {length} байт)")

            # Обработка разных типов чанков
            if chunk_type == 'tEXt':
                # Текстовый чанк
                try:
                    null_pos = data.find(b'\x00')
                    if null_pos != -1:
                        keyword = data[:null_pos].decode('utf-8', errors='ignore')
                        text = data[null_pos + 1:].decode('utf-8', errors='ignore')
                        print(f"   📝 Ключ: {keyword}")
                        print(f"   📝 Текст: {text}")
                        messages.append(('tEXt', text))
                except Exception as e:
                    print(f"   ⚠️ Ошибка: {e}")

            elif chunk_type == 'zTXt':
                # Сжатый текстовый чанк
                try:
                    null_pos = data.find(b'\x00')
                    if null_pos != -1:
                        keyword = data[:null_pos].decode('utf-8', errors='ignore')
                        compression_method = data[null_pos + 1] if null_pos + 1 < len(data) else 0
                        compressed_data = data[null_pos + 2:]
                        if compression_method == 0:
                            text = zlib.decompress(compressed_data).decode('utf-8', errors='ignore')
                            print(f"   📝 Ключ: {keyword}")
                            print(f"   📝 Текст: {text}")
                            messages.append(('zTXt', text))
                        else:
                            print(f"   📝 Ключ: {keyword} (метод сжатия: {compression_method})")
                except Exception as e:
                    print(f"   ⚠️ Ошибка распаковки zTXt: {e}")

            elif chunk_type == 'iTXt':
                # Интернациональный текстовый чанк
                try:
                    parts = data.split(b'\x00')
                    if len(parts) >= 4:
                        keyword = parts[0].decode('utf-8', errors='ignore')
                        language = parts[1].decode('utf-8', errors='ignore') if len(parts) > 1 else ''
                        translated = parts[2].decode('utf-8', errors='ignore') if len(parts) > 2 else ''
                        text = parts[3].decode('utf-8', errors='ignore') if len(parts) > 3 else ''
                        print(f"   📝 Ключ: {keyword}")
                        print(f"   📝 Текст: {text}")
                        messages.append(('iTXt', text))
                except Exception as e:
                    print(f"   ⚠️ Ошибка iTXt: {e}")

            elif chunk_type == 'IHDR':
                # Заголовок изображения
                if length >= 13:
                    width, height, bit_depth, color_type, compression, filter_method, interlace = struct.unpack(
                        '>IIBBBBB', data[:13])
                    print(f"   🖼️ Размер: {width}x{height}")
                    print(f"   🖼️ Глубина: {bit_depth} бит")
                    print(f"   🖼️ Тип цвета: {color_type}")
                    chunks_info.append(('IHDR', width, height))

            elif chunk_type == 'IDAT':
                print(f"   📊 Данные изображения (часть {chunk_count})")

            elif chunk_type == 'IEND':
                print("   🏁 Конец изображения")
                break

            elif chunk_type in ['PLTE', 'bKGD', 'cHRM', 'gAMA', 'hIST', 'pHYs', 'sBIT', 'sPLT', 'sRGB']:
                print(f"   🔧 Стандартный чанк: {chunk_type}")

            elif chunk_type in ['acTL', 'fcTL', 'fdAT']:
                print(f"   🎞️ APNG чанк: {chunk_type}")

            else:
                # Неизвестный чанк
                print(f"   ⚠️ НЕИЗВЕСТНЫЙ ЧАНК!")
                # Пытаемся прочитать как текст
                try:
                    text = data.decode('utf-8', errors='ignore')
