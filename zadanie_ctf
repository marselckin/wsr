  // Build sorted indices for greedy
  let indices = [...Array(A.length).keys()];

  if (orderName === "desc") {
    indices.sort((i, j) => A[j] - A[i]); // decreasing by weight
  } else if (orderName === "asc") {
    indices.sort((i, j) => A[i] - A[j]); // increasing
  } else {
    throw new Error("unknown orderName");
  }

  // weights in the order we feed greedy
  const W = indices.map(i => A[i]);

  // For each ciphertext element, recover a bit vector of length n
  const n = A.length;
  const allBits = [];

  // greedy will produce bits aligned with W order; map back to original bit positions
  for (const c of ciphertext) {
    // classic MH: c' = c * r^{-1} mod q
    const cPrime = (c * rInv) % q;

    const { bits: bitsW, remainder } = greedyDecompose(W, cPrime);

    // If remainder != 0, greedy failed for this ordering
    // We still record bits for debugging; you can also break.
    if (remainder !== 0) {
      // Uncomment to be strict:
      // throw new Error(`Greedy failed (remainder=${remainder})`);
    }

    // Map bits back: bitsW[k] corresponds to indices[k] in original A order.
    const bitsAorder = new Array(n).fill(0);
    for (let k = 0; k < n; k++) {
      bitsAorder[indices[k]] = bitsW[k];
    }

    // MSB first: interpret bitsAorder as m1..mn where m1 is MSB.
    // Our ciphertext scheme in MH typically uses m1..mn mapped to A[0..n-1].
    allBits.push(...bitsAorder);
  }

  const buf = bytesFromBits(allBits, data.bit_order);
  return {
    orderName,
    privateA: A,
    decoded: buf.toString("utf8"),
    decodedHex: buf.toString("hex"),
    allBits,
  };
}

