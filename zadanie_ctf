from scapy.all import *

# ====== НАСТРОЙКИ ======
PCAP_FILE = "capture.pcap"    # путь к вашему pcap
SRC_PORT = 40000
DST_PORT = 40002
PASSWORD = "bluebird"

# ====== 1. СБОР RTP PAYLOAD ПО ПОРЯДКУ SEQUENCE ======
print("[*] Чтение pcap...")
packets = rdpcap(PCAP_FILE)

payloads = {}  # key: sequence, value: payload (байты)

for pkt in packets:
    # Фильтр по UDP-портам
    if UDP in pkt and pkt[UDP].sport == SRC_PORT and pkt[UDP].dport == DST_PORT:
        udp_data = bytes(pkt[UDP].payload)
        if len(udp_data) > 12:  # минимальный RTP-заголовок
            # Извлекаем sequence из RTP-заголовка (байты 2-3)
            seq = int.from_bytes(udp_data[2:4], byteorder='big')
            # Извлекаем payload (после 12 байт заголовка)
            payload = udp_data[12:]
            if seq not in payloads:  # удаляем дубликаты
                payloads[seq] = payload

if not payloads:
    print("[-] RTP-пакеты не найдены. Проверьте порты и pcap.")
    exit(1)

# Сортировка по sequence и объединение
full_data = b''.join(payloads[seq] for seq in sorted(payloads.keys()))
print(f"[+] Собрано пакетов: {len(payloads)}")
print(f"[+] Общий размер данных: {len(full_data)} байт")

# ====== 2. ГЕНЕРАЦИЯ КЛЮЧА ======
key = hashlib.sha256(PASSWORD.encode()).digest()
print(f"[+] Ключ (SHA-256): {key.hex()[:16]}... (длина {len(key)} байт)")

# ====== 3. XOR РАСШИФРОВКА ======
decrypted = bytearray()
for i in range(len(full_data)):
    decrypted.append(full_data[i] ^ key[i % len(key)])
decrypted = bytes(decrypted)

# ====== 4. СОХРАНЕНИЕ И ВЫВОД ======
# Сохраняем как бинарный файл
with open("decrypted_output.bin", "wb") as f:
    f.write(decrypted)
