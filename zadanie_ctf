def decode_midi_secret(filename):
    """
    Извлекает ASCII из velocity Note On событий первого канала
    """
    with mido.MidiFile(filename) as mid:
        ascii_codes = []

        for track in mid.tracks:
            for msg in track:
                # Note On, первый канал (0), velocity > 0
                if msg.type == 'note_on' and msg.channel == 0 and msg.velocity > 0:
                    ascii_codes.append(msg.velocity)

