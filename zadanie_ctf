function modInv(a, m) {
  // extended gcd
  let t = 0, newT = 1;
  let r = m, newR = ((a % m) + m) % m;
  while (newR !== 0) {
    const q = Math.floor(r / newR);
    [t, newT] = [newT, t - q * newT];
    [r, newR] = [newR, r - q * newR];
  }
  if (r !== 1) throw new Error("No modular inverse");
  return ((t % m) + m) % m;
}

function bytesFromBits(bits, bitOrder = "MSB first") {
  // bits: array of 0/1 length multiple of 8
  if (bits.length % 8 !== 0) {
    // truncate to full bytes if needed
    bits = bits.slice(0, bits.length - (bits.length % 8));
  }
  const out = [];
  for (let i = 0; i < bits.length; i += 8) {
    let byte = 0;
    if (bitOrder === "MSB first") {
      for (let j = 0; j < 8; j++) byte = (byte << 1) | bits[i + j];
    } else {
      for (let j = 0; j < 8; j++) byte |= (bits[i + j] << j);
    }
    out.push(byte);
  }
  return Buffer.from(out);
}

function greedyDecompose(weights, sum) {
  // weights must be superincreasing for correct greedy
  // returns bits array aligned with weights order
  let c = sum;
  const bits = new Array(weights.length).fill(0);
  for (let i = weights.length - 1; i >= 0; i--) {
    if (weights[i] <= c) {
      bits[i] = 1;
      c -= weights[i];
    }
  }
  return { bits, remainder: c };
}

