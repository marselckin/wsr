import wave
import numpy as np
import struct
from scipy.signal import hilbert


def decode_wav_proper(filename):
    with wave.open(filename, 'rb') as wav:
        sample_rate = wav.getframerate()
        n_frames = wav.getnframes()
        frames = wav.readframes(n_frames)
        samples = struct.unpack(f"{n_frames}h", frames)
        samples = np.array(samples)
        samples = samples / np.max(np.abs(samples))

        # Огибающая
        analytic = hilbert(samples)
        envelope = np.abs(analytic)

        # Находим порог
        threshold = np.mean(envelope) + 0.2 * np.std(envelope)
        signal = envelope > threshold

        # Находим все переходы (начала и концы импульсов)
        transitions = []
        for i in range(1, len(signal)):
            if signal[i] != signal[i - 1]:
                transitions.append(i)

        print(f"Найдено переходов: {len(transitions)}")

        # Извлекаем длительности импульсов и пауз
        pulses = []
        gaps = []

        i = 0
        while i < len(transitions) - 1:
            # Проверяем, является ли это началом импульса (signal = True)
            if signal[transitions[i]] == True:
                # Длительность импульса
                pulse_duration = (transitions[i + 1] - transitions[i]) * 1000 / sample_rate
                pulses.append(pulse_duration)

                # Если есть следующая пара
                if i + 2 < len(transitions):
                    # Длительность паузы
                    gap_duration = (transitions[i + 2] - transitions[i + 1]) * 1000 / sample_rate
                    gaps.append(gap_duration)

                i += 2
            else:
                i += 1

        print(f"Найдено импульсов: {len(pulses)}")
        print(f"Найдено пауз: {len(gaps)}")

        # Определяем единицу времени (70 мс)
        unit = 70

        print("\nДлительности импульсов (первые 100):")
        for i, p in enumerate(pulses[:100]):
            print(f"  {i + 1}: {p:.1f} мс", end=" ")
            if p < unit * 1.5:
                print("(.)")
            elif p < unit * 3.5:
                print("(-)")
            else:
                print("(длинный)")

        print("\nДлительности пауз (первые 100):")
        for i, g in enumerate(gaps[:100]):
            print(f"  {i + 1}: {g:.1f} мс", end=" ")
            if g < unit * 1.5:
                print("(между элементами)")
            elif g < unit * 3.5:
                print("(между буквами)")
            else:
                print("(между словами)")

        # Преобразуем в символы Морзе с учетом пауз
        morse_letters = []
        current_letter = []

        for i, pulse in enumerate(pulses):
            # Определяем символ
            if pulse < unit * 1.5:
                current_letter.append('.')
            elif pulse < unit * 3.5:
                current_letter.append('-')
            else:
                current_letter.append(' ')  # Разделитель

            # Проверяем паузу после этого импульса
            if i < len(gaps):
                gap = gaps[i]
                if gap > unit * 2.5 and gap < unit * 4.5:
                    # Конец буквы
                    if current_letter:
                        morse_letters.append(''.join(current_letter))
                        current_letter = []
                elif gap > unit * 5:
                    # Конец слова
                    if current_letter:
                        morse_letters.append(''.join(current_letter))
                        current_letter = []
                    morse_letters.append('/')

        # Последняя буква
        if current_letter:
            morse_letters.append(''.join(current_letter))

        print(f"\nМорзе (разбито по буквам):")
        print(' '.join(morse_letters))

        # Декодируем
        morse_code = {
            '.-': 'A', '-...': 'B', '-.-.': 'C', '-..': 'D', '.': 'E',
            '..-.': 'F', '--.': 'G', '....': 'H', '..': 'I', '.---': 'J',
            '-.-': 'K', '.-..': 'L', '--': 'M', '-.': 'N', '---': 'O',
