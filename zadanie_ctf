#!/usr/bin/env python3
import re
from scapy.all import *

PCAP_FILE = "capture1.pcap"


def parse_mqtt_publish(tcp_data):
    """Ручной парсинг MQTT PUBLISH."""
    if not tcp_data or len(tcp_data) < 5:
        return None

    first_byte = tcp_data[0]
    msgtype = (first_byte >> 4) & 0x0F
    retain = first_byte & 0x01

    if msgtype != 3 or retain != 1:
        return None

    # Длина оставшихся данных
    remaining_len = tcp_data[1]
    if len(tcp_data) < 2 + remaining_len:
        return None

    # Тема
    topic_len = int.from_bytes(tcp_data[2:4], byteorder='big')
    topic_start = 4
    topic_end = topic_start + topic_len

    if len(tcp_data) < topic_end:
        return None

    topic = tcp_data[topic_start:topic_end].decode('utf-8', errors='ignore')
    payload = tcp_data[topic_end:]

    return topic, payload


print("[*] Чтение PCAP...")
packets = rdpcap(PCAP_FILE)
messages = {}

for pkt in packets:
    if TCP in pkt and (pkt[TCP].sport == 1883 or pkt[TCP].dport == 1883):
        result = parse_mqtt_publish(bytes(pkt[TCP].payload))
        if result:
            topic, payload = result
            match = re.search(r'/(\d+)$', topic)
            if match:
                num = int(match.group(1))
                if num not in messages:
                    messages[num] = payload

if not messages:
    print("[-] Ничего не найдено.")
    exit(1)

full_data = b''.join(messages[num] for num in sorted(messages.keys()))

with open("mqtt_payload.bin", "wb") as f:
    f.write(full_data)

print(f"[+] Собрано {len(full_data)} байт")
print(f"[+] Первые 32 байта: {full_data[:32].hex()}")

try:
    print(full_data.decode('utf-8'))
except UnicodeDecodeError:
    print("(бинарные данные)")

