ЗАДАНИЕ CRYPTO-04 — Бит роли
Сервис показывает известный plaintext и токен формата IV || AES-CBC(ciphertext). Измените токен без знания ключа так, чтобы role=guest превратилось в role=admin, и передайте hex в https://ctf.82.202.138.50.sslip.io/arena/crypto/c4/check?token=....

//Решение
Снова через джава, через питон не получилось

// cbc-bitflip.js
// Usage: node cbc-bitflip.js
const tokenHex = "f2344c160501bcd83db2fa51a11eb3974b45d05af66377ff5a2d93c18f381324a42b0cdb316bcf91f169e5a6b5228358";
const template = "role=guest;uid=1042;scope=read";

const BLOCK = 16;
const from = Buffer.from("guest", "ascii");
const to   = Buffer.from("admin", "ascii");

function hexToBuf(h) { return Buffer.from(h, "hex"); }
function bufToHex(b) { return b.toString("hex"); }

const token = hexToBuf(tokenHex);
const iv = Buffer.from(token.subarray(0, BLOCK));
const ct = Buffer.from(token.subarray(BLOCK));

if (ct.length % BLOCK !== 0) throw new Error("Ciphertext length must be multiple of block size");

const nBlocks = ct.length / BLOCK;

// plaintext block indices: P1..Pn correspond to decrypt(C1)..decrypt(Cn)
// each plaintext byte at global position pos controls ciphertext byte at same pos%BLOCK in block (pos/BLOCK - 1),
// or in IV when pos/BLOCK == 0.
const guestOffset = Buffer.from(template, "ascii").indexOf("guest");
if (guestOffset < 0) throw new Error("Can't find guest in template");

const ctBlocks = [];
for (let i = 0; i < nBlocks; i++) ctBlocks.push(Buffer.from(ct.subarray(i * BLOCK, (i + 1) * BLOCK)));

// Apply deltas for each char: newP = oldP XOR delta => delta = oldByte XOR newByte
// Since old bytes are unknown, we use delta = from[k] XOR to[k] because we want to flip
// the plaintext bytes from 'guest' to 'admin'.
for (let k = 0; k < from.length; k++) {
  const pos = guestOffset + k;           // global plaintext byte index
  const plainBlockIndex0 = Math.floor(pos / BLOCK); // 0 => first plaintext block
  const idxInBlock = pos % BLOCK;

  const delta = from[k] ^ to[k];

  if (plainBlockIndex0 === 0) {
    // controlled by IV
    iv[idxInBlock] ^= delta;
  } else {
    // controlled by previous ciphertext block
    const prevCipherBlock = plainBlockIndex0 - 1; // ciphertext block index in ctBlocks[]
    ctBlocks[prevCipherBlock][idxInBlock] ^= delta;
  }
}

const newToken = Buffer.concat([iv, ...ctBlocks]);
console.log("NEW TOKEN HEX:", bufToHex(newToken));

