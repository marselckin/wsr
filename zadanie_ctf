            '--..': 'Z',
            '..--..': '?', '-.-.--': '!', '.-.-.-': '.', '--..--': ','
        }

        decoded = []
        for letter in morse_letters:
            if letter in morse_code:
                decoded.append(morse_code[letter])
            elif letter == '/':
