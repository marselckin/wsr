import json
import heapq
import re


def find_flag(filename):
    with open(filename, 'r', encoding='utf-8') as f:
        data = json.load(f)

    # Строим граф из edges
    graph = {}
    for node in data['nodes']:
        graph[node] = {}

    for frm, to, weight in data['edges']:
        graph[frm][to] = weight

    # Фрагменты
    fragments = {node: data['nodes'][node]['fragment'] for node in data['nodes']}

    start = data['start']
    end = data['target']

    # Дейкстра
    dist = {n: float('inf') for n in graph}
    dist[start] = 0
    prev = {n: None for n in graph}
    pq = [(0, start)]

    while pq:
        d, n = heapq.heappop(pq)
        if n == end:
            break
        if d > dist[n]:
            continue
        for nb, w in graph[n].items():
            nd = d + w
            if nd < dist[nb]:
                dist[nb] = nd
                prev[nb] = n
                heapq.heappush(pq, (nd, nb))

    # Восстанавливаем путь
    path = []
    n = end
    while n is not None:
        path.append(n)
        n = prev[n]
    path.reverse()

    # Собираем флаг
    flag = ''.join([fragments[n] for n in path])

    print(f"Кратчайший путь: {' → '.join(path)}")
    print(f"Суммарный вес: {dist[end]}")
    print(f"Флаг: {flag}")

    return flag


