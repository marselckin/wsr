import zipfile
import re


def decode_zip_sorted(filename):
    """
    Извлекает, сортирует по piece_index и соединяет фрагменты
    """
    fragments = []

    with zipfile.ZipFile(filename, 'r') as zip_ref:
        for info in zip_ref.infolist():
            if info.comment:
                comment = info.comment.decode('utf-8', errors='ignore')

                # Извлекаем piece_index
                pi_match = re.search(r'piece_index\s*[:=]\s*(\d+)', comment, re.IGNORECASE)
                piece_index = int(pi_match.group(1)) if pi_match else 9999

                # Извлекаем часть после piece=
                p_match = re.search(r'piece\s*[:=]\s*([^;]+)', comment, re.IGNORECASE)
                content = p_match.group(1).strip() if p_match else comment.strip()

                fragments.append((piece_index, content))
                print(f"  [{piece_index}] {content}")

    # СОРТИРУЕМ
    fragments.sort(key=lambda x: x[0])

    print("\n" + "=" * 60)
    print("📊 Отсортированные фрагменты:")
    for piece_index, content in fragments:
        print(f"  [{piece_index}] {content}")

    # СОЕДИНЯЕМ
    flag = ''.join([c[1] for c in fragments])
    print(f"\n📦 Флаг: {flag}")

    # Ищем RTK{...}
    match = re.search(r'RTK\{[^}]+\}', flag)
    if match:
        print(f"✅ {match.group()}")
        return match.group()

    return flag


# Использование
decode_zip_sorted('archive.zip')

