# 1. Вычисляем разности t[n] = x[n+1] - x[n]
t = [states[i+1] - states[i] for i in range(len(states)-1)]
print("Разности t:", t)

# 2. Восстанавливаем модуль m
# Для LCG: t[n+1] ≡ a * t[n] (mod m)
# Используем: m = gcd(|t[1]^2 - t[0]*t[2]|, |t[2]^2 - t[1]*t[3]|)
vals = []
for i in range(len(t)-2):
    vals.append(abs(t[i+1]**2 - t[i]*t[i+2]))

m = vals[0]
for v in vals[1:]:
    m = math.gcd(m, v)

